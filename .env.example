# Copy this file to .env and fill in real values. Never commit .env.

# Signs the session cookie. Use a long random string in production.
SECRET_KEY=change-me-to-a-long-random-string

# SQLite locally (zero setup). On Render this is set to a Postgres URL.
DATABASE_URL=sqlite:///./picksportplus.db

# https://the-odds-api.com/ Free plan, 500 credits per month. Optional.
# Without it the app falls back to ESPN odds only.
ODDS_API_KEY=

# https://collegefootballdata.com/key Free. Optional college-only spread fallback.
CFBD_API_KEY=

# Metered provider budgets, per calendar month. The app stops calling a provider once
# its budget is spent and falls back to ESPN, which is keyless and unmetered.
# Set below the true free limits (500 and 1000) to leave headroom.
ODDS_API_MONTHLY_BUDGET=400
CFBD_MONTHLY_BUDGET=800

# Metered spread pulls allowed per pool week. ESPN scores are unmetered and unaffected.
MAX_SPREAD_REFRESHES_PER_WEEK=4
# CFBD is a last-resort college-only fallback, capped separately per week.
MAX_CFBD_CALLS_PER_WEEK=1
# How long a cached spread pull stays fresh, in minutes. Reused instead of respending credits.
SPREAD_CACHE_MINUTES=360

# Season the pool runs. ESPN uses the year the season starts in.
SEASON_YEAR=2026

# The Saturday pool week 1 anchors to. Each enabled league resolves its own ESPN week from
# this date (NFL and college calendars are not aligned, see DECISIONS.md, Phase 1). Threaded
# onto a freshly seeded pool's Pool.week1_anchor_date by seed-admin; a commissioner can also
# change it later from Admin, Pool settings. Leave blank to seed a pool with no anchor set.
WEEK1_ANCHOR_DATE=2026-09-12

# false = private pool, registration requires a valid join code.
# true  = anyone may self-register (public mode).
OPEN_REGISTRATION=false

# Created by: python -m app.cli seed-admin
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=set-a-strong-one
ADMIN_DISPLAY_NAME=Commissioner

# The default pool created by seed-admin.
DEFAULT_POOL_NAME=PickSportPlus
DEFAULT_JOIN_CODE=make-one-up

# Display timezone for kickoffs and lock times.
TIMEZONE=America/New_York

# Seed slate size for a NEW pool. The commissioner owns these once the pool exists,
# from Admin, Pool settings. Total 20, split 8 NFL and 12 college.
# The per league numbers are targets. If a league is short of games with a resolvable
# spread that week, the shortfall is filled from the other league so the total still lands.
NUM_GAMES_PER_WEEK=20
NFL_GAMES_PER_WEEK=8
NCAAF_GAMES_PER_WEEK=12

# How many days before the first kickoff a slate may auto-publish.
PUBLISH_LEAD_DAYS=6

# Set to true only in tests or offline demos. Blocks all outbound HTTP.
OFFLINE_MODE=false

# Transactional email (invites, password reset, week-published notifications). Off by
# default: a fresh deploy never sends anything until this is explicitly turned on, and every
# feature keeps working through its existing copy-and-paste link/code fallback when it is off.
MAIL_ENABLED=false
# https://resend.com/ Free plan, 3000 emails a month, 100 a day. Optional; blank with
# MAIL_ENABLED=false is the normal state for local dev.
RESEND_API_KEY=
# Must be a verified sender on the Resend account (or a domain you control there).
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=PickSportPlus
# Per sender (a site admin, a commissioner, or an anonymous password reset request keyed by
# the address it targets) in a rolling hour, counted from real MailLog rows, not memory.
MAIL_RATE_LIMIT_PER_HOUR=20

# Shown in the footer and on the terms and privacy pages.
OPERATOR_NAME=Spencer Innovations
OPERATOR_URL=https://spencerinv.com
# Contact address on the legal pages. Falls back to ADMIN_EMAIL when left blank.
CONTACT_EMAIL=
# Bump by hand whenever the legal wording changes.
LEGAL_EFFECTIVE_DATE=August 2, 2026
